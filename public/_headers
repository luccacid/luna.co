# Cloudflare Pages — equivalente ao que o .htaccess faz no Apache.
# A Cloudflare ignora .htaccess; sem este arquivo os headers de segurança
# sumiriam em silêncio ao migrar de host.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Assets com hash no nome nunca mudam de conteúdo: cache longo e imutável.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

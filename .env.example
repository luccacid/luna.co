# Copie para .env.local (dev) e configure como variável no build de produção.
# Enquanto cada valor estiver vazio, o recurso correspondente não é renderizado.

# WhatsApp: número com DDI, só dígitos. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP=

# Endpoint do formulário de contato. Aceita POST JSON e devolve 2xx.
# Formspree:   https://formspree.io/f/xxxxxxxx
# Web3Forms:   https://api.web3forms.com/submit   (envie access_key no corpo)
NEXT_PUBLIC_FORM_ENDPOINT=

# Analytics (Plausible): o domínio cadastrado na conta. Ex.: lunaco.tech
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Hosts (definidos pelo CI; em dev não precisa)
# NEXT_PUBLIC_BASE_PATH=/luna.co
# NEXT_PUBLIC_SITE_URL=https://luccacid.github.io
